<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="💡"
            android:textSize="65sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Feira"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tecnológica"
            android:textColor="#00D9FF"
            android:textSize="30sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="28dp"
            android:text="Acesse sua conta para continuar"
            android:textColor="#D0DCEF"
            android:textSize="15sp"/>

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_input"
            android:hint="✉  E-mail"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="18dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#AFC1DC"
            android:singleLine="true"/>

        <EditText
            android:id="@+id/etSenha"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input"
            android:hint="🔒  Senha"
            android:inputType="textPassword"
            android:paddingHorizontal="18dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#AFC1DC"
            android:singleLine="true"/>

        <TextView
            android:id="@+id/tvEsqueciSenha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="end"
            android:text="Esqueci minha senha"
            android:textColor="#00D9FF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnEntrar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_button"
            android:backgroundTint="@null"
            android:text="Entrar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="────────────  ou  ────────────"
            android:textColor="#7188AB"/>

        <Button
            android:id="@+id/btnCadastrar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_outline_button"
            android:backgroundTint="@null"
            android:text="Criar conta"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"/>
    </LinearLayout>
</ScrollView>