<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#151515">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:src="@drawable/fabrica_industrial"
            android:scaleType="centerCrop"
            android:contentDescription="Fábrica da Revolução Industrial" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REVOLUÇÃO INDUSTRIAL"
                android:textColor="#D4AF37"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descubra como máquinas, invenções e novas formas de produção transformaram o mundo."
                android:textColor="#DDDDDD"
                android:textSize="16sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="22dp" />

            <Button
                android:id="@+id/btnHistoria"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:text="HISTÓRIA"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="17sp"
                android:backgroundTint="#8B1E1E" />

            <Button
                android:id="@+id/btnFases"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:layout_marginTop="12dp"
                android:text="FASES DA REVOLUÇÃO"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="17sp"
                android:backgroundTint="#8B1E1E" />

            <Button
                android:id="@+id/btnInventores"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:layout_marginTop="12dp"
                android:text="INVENTORES"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="17sp"
                android:backgroundTint="#8B1E1E" />

            <Button
                android:id="@+id/btnImpactos"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:layout_marginTop="12dp"
                android:text="IMPACTOS"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="17sp"
                android:backgroundTint="#8B1E1E" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>